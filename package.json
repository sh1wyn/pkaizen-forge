{
  "name": "pkaizen-forge",
  "version": "0.1.1",
  "description": "Pkaizen Forge — optimisation PC sûre et réversible : diagnostic matériel, boost FPS/latence, nettoyage et pilotes officiels (desktop & laptop)",
  "main": "./out/main/index.js",
  "author": "sh1wyn",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "audit:app": "node scripts/audit.mjs",
    "dist": "npm run typecheck && node scripts/audit.mjs && electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "systeminformation": "^5.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.sh1wyn.pkaizenforge",
    "productName": "Pkaizen Forge",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
